# Ignore configuration files containing sensitive information
/includes/config.prod.php

# Never commit database dumps, they contain customer data
*.sql
!/database/carrental.template.sql

# Ignore environment files
.env
*.env

# Ignore log and cache files
*.log
logs/
/storage/logs/*
!/storage/logs/.gitkeep
/storage/cache/*
!/storage/cache/.gitkeep

# Ignore vendor directories
/vendor/
/node_modules/

# Ignore IDE and editor files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Ignore OS generated files
.DS_Store
Thumbs.db

# Ignore backup files
*.bak
*.swp
*~

# Ignore compiled files
*.com
*.class
*.dll
*.exe
*.o
*.so

# Ignore packaged files
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip
