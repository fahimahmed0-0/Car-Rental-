# Application
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost/Car-Rental-
APP_TIMEZONE=Asia/Kolkata
SESSION_DRIVER=file

# Database Configuration (set DB_PORT=4000 & DB_SSL=true for Cloud MySQL like TiDB/Aiven)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=carrental
DB_SSL=false
DB_SSL_CA=

# Email Configuration (if unset, emails queue safely in tblmailoutbox)
SMTP_HOST=smtp.example.com
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
SMTP_PORT=587
EMAIL_FROM=noreply@drivexassam.local
EMAIL_FROM_NAME="DriveX Assam"
EMAIL_TO=admin@drivexassam.local
EMAIL_TO_NAME="DriveX Admin"

# Payment Gateway (sandbox works out-of-the-box; set keys for live Razorpay)
PAYMENT_MODE=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloud Image Uploads for Vercel Serverless (optional; https:// URLs also work)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Engine (Tier 1 Cloud LLM -> Tier 2 Local Ollama -> Tier 3 Deterministic PHP)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_LOCAL_URL=
AI_LOCAL_MODEL=llama3.2
AI_TIMEOUT_SEC=5
